MACHINE_ID=1

# App
DEBUG=true
ENV=development
PORT=8080
APP_NAME=gofi
APP_SECRET=

# Super user created on boot when SEED_ON_BOOT=true, as email:password.
# The password must be 12 to 128 characters, so replace this one.
SUPER_USER=admin@mail.com:admin123

# Comma-separated browser origins allowed to call the API cross-origin.
# Empty disables CORS (same-origin only).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Apply embedded migrations when the API boots
MIGRATE_ON_BOOT=true
# Run the idempotent seeders when the API boots (needs SUPER_USER)
SEED_ON_BOOT=false

DB_DSN=postgres://postgres:postgres@localhost:5432/gofi?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_MAX_IDLE_TIME=15m

# Auth (Authula, mounted at /v1/auth). APP_SECRET also signs Authula tokens.
# Public URL of this API, used in email links and the Google callback;
# empty defaults to http://localhost:$PORT.
AUTH_BASE_URL=http://localhost:8080
# Resend sender (must be a verified domain) and API key
FROM_ADDRESS=noreply@example.com
RESEND_API_KEY=
# Google OAuth client; empty disables Google sign-in. Authorized redirect URI:
# $AUTH_BASE_URL/v1/auth/oauth2/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SENTRY_DSN=
